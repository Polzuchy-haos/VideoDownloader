{
  "manifest_version": 3,
  "name": "Dreamcast DownloadEx",
  "version": "1.1.0",
  "description": "Перехват и скачивание видео из плееров Kodik, Alloha, CVH (HLS / MP4).",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "webRequest",
    "declarativeNetRequestWithHostAccess",
    "downloads",
    "tabs",
    "webNavigation",
    "storage",
    "scripting",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/relay.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "pick-player": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Выбрать плеер на странице и скачать видео из него"
    }
  },
  "action": {
    "default_title": "Dreamcast DownloadEx",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/popup.html"
  }
}
